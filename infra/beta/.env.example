# Realm beta server settings. Copy to infra/beta/.env ON THE SERVER and fill in the values there.
# Never put real values in this file and never commit infra/beta/.env (git ignores it).
# Guide: docs/BETA-SERVER.md

# ── Addresses ────────────────────────────────────────────────────────────────────────────────
# The website, the phone app's API and voice. Each needs an A record in Cloudflare (DNS only).
WEB_DOMAIN=
API_DOMAIN=
VOICE_DOMAIN=
# https:// + WEB_DOMAIN. Used in emails and links.
REALM_WEB_ORIGIN=

# ── Keys made on the server (openssl rand -base64 48) ────────────────────────────────────────
REALM_SECRET=
VALKEY_PASSWORD=

# ── Database (Neon) ──────────────────────────────────────────────────────────────────────────
# The pooled address, and the direct one (used only by database changes).
DATABASE_URL=
DATABASE_DIRECT_URL=

# ── Email (Resend) ───────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
# The sender: Realm <no-reply@tomyrealm.com>, on the domain verified in Resend.
SMTP_FROM=
# The address shown at the bottom of every email for questions (Cloudflare forwards it).
REALM_CONTACT_EMAIL=info@tomyrealm.com
# Where server problems and safety reports are sent.
REALM_ALERT_EMAIL=
REALM_SAFETY_EMAIL=

# ── Uploads (Cloudflare R2) ──────────────────────────────────────────────────────────────────
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# The public address uploads are served from (the website's security policy allows it).
REALM_STORAGE_ORIGIN=
# Uploads stop at this size so the free tier is never passed.
REALM_STORAGE_LIMIT_GB=9

# ── Voice and video (LiveKit, runs on this server) ───────────────────────────────────────────
# wss:// + VOICE_DOMAIN
LIVEKIT_URL=
# Make both on the server: openssl rand -hex 12 (key) and openssl rand -base64 36 (secret).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Safety switches ──────────────────────────────────────────────────────────────────────────
# Keep "off" until end-to-end encrypted messages are finished and checked.
REALM_E2EE_DMS=off
# Checks new passwords against known leaked ones (sends only part of a hash).
REALM_PWNED_PASSWORDS=true

# ── Optional ─────────────────────────────────────────────────────────────────────────────────
# Notifications (Firebase). The server's key: the service account JSON, as base64 on one line.
# SECRET. Empty = no notifications.
FIREBASE_SERVICE_ACCOUNT=
# The website's Firebase settings (public: Firebase console › Project settings › Your apps › web,
# and Cloud Messaging › Web Push certificates for the VAPID key).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Free music search (Realm's own song library). Works without a key, with a lower limit.
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
# Maps: empty = the free OpenStreetMap maps (no key needed). Set one of these to use Google or
# Mapbox instead (public keys: lock them to WEB_DOMAIN in that service's settings).
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=
