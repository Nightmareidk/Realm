# Copy to .env (never commit it).
# The voice address, pointed at this server's IP in your DNS: e.g. voice.yourdomain.com
VOICE_DOMAIN=voice.example.com
# One API key and secret for Realm. Make them with:
#   echo "API$(openssl rand -hex 6): $(openssl rand -base64 32)"
LIVEKIT_KEYS="APIxxxxxxxxxxxx: replace-with-a-long-random-secret"
