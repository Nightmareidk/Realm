{
  "name": "realm",
  "private": true,
  "description": "Realm — communities, chat, posts and clips in one place.",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --recursive --parallel --stream run dev",
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "db:generate": "pnpm --filter @realm/db generate",
    "db:migrate": "pnpm --filter @realm/db migrate",
    "db:seed": "pnpm --filter @realm/db seed"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "typescript": "6.0.3"
  }
}
