{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "24.16.0",
      "pnpm": "12.6.0",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "node": "24.16.0",
      "pnpm": "12.6.0",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "node": "24.16.0",
      "pnpm": "12.6.0",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_REALM_API_URL": "https://api.tomyrealm.com",
        "EXPO_PUBLIC_REALM_GATEWAY_URL": "wss://api.tomyrealm.com/gateway",
        "EXPO_PUBLIC_REALM_WEB_URL": "https://tomyrealm.com"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "beta-apk": {
      "extends": "production",
      "distribution": "internal",
      "autoIncrement": false,
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "alpha",
        "releaseStatus": "draft"
      }
    }
  }
}
