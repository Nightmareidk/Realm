{
  "expo": {
    "name": "Realm",
    "slug": "realm",
    "scheme": "realm",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0b0e",
    "android": {
      "package": "com.tomyrealm",
      "allowBackup": false,
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "ios": {
      "bundleIdentifier": "com.tomyrealm"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Realm opens your photos when you choose one to post or send.",
          "cameraPermission": "Realm uses the camera when you take a photo or record a Clip to share.",
          "microphonePermission": "Realm uses the microphone when you record a Clip."
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0b0e",
          "image": "./assets/icon.png",
          "imageWidth": 120,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3f7bf014-2555-4858-84f8-02121af3d709"
      }
    },
    "owner": "realmapp"
  }
}
