{
  "name": "@realm/design-tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Realm design tokens (The Atlas). Source of truth in TS; compiled to CSS variables for web, consumed as data by native later.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./tokens.css"
  },
  "scripts": {
    "build": "tsx src/build.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@realm/tsconfig": "workspace:*",
    "@types/node": "26.6.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
