# Copy to .env for local development. Never commit real secrets.

NODE_ENV=development

# Public origin of the web app (used for links in emails, CORS/Origin checks)
REALM_WEB_ORIGIN=http://localhost:3000
REALM_API_PORT=4000
REALM_GATEWAY_PORT=4001
REALM_GATEWAY_URL=ws://localhost:4001

# Snowflake worker ID for this process (0–1023). Leased from Redis in production.
REALM_WORKER_ID=1

DATABASE_URL=postgres://realm:realm@localhost:5432/realm
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=realm-media
S3_ACCESS_KEY_ID=realm
S3_SECRET_ACCESS_KEY=realm-dev-secret
S3_PUBLIC_URL=http://localhost:9000/realm-media

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Realm <no-reply@realm.localhost>"
