# Copy to .env for local development. Never commit real secrets.
#
# Every outside service below is optional while developing: leave it unset and Realm uses a
# local stand-in (files in a folder, emails in the API's log, no push, no calls). Set the keys
# to switch each one on. docs/SERVICES.md walks through creating each account.

NODE_ENV=development

# Public origin of the web app (links in emails, Origin checks, the gateway's allowed origin)
REALM_WEB_ORIGIN=http://localhost:3000
REALM_API_PORT=4000
# Signs short codes and local upload links. 32+ random characters in production.
# REALM_SECRET=

# ── Database: Postgres (Neon or Supabase in production) ─────────────────────────
# No database installed? The embedded one works for development (data in .data/, git-ignored):
DATABASE_URL=pglite:.data/pglite
# Neon:     DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/realm?sslmode=require
# Supabase: DATABASE_URL=postgres://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# Migrations want the direct (non-pooled) URL:
# DATABASE_DIRECT_URL=postgres://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/realm?sslmode=require

# ── Redis: Upstash ──────────────────────────────────────────────────────────────
# Unset = in-memory (one process). Set it to run the gateway and worker as their own processes.
# REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379

# ── Email: Resend ───────────────────────────────────────────────────────────────
# Unset = emails (with their codes and links) are written to the API's log.
# RESEND_API_KEY=re_...
SMTP_FROM="Realm <no-reply@realm.localhost>"
# Where the gravest reports (sexual content involving someone under 18) are emailed, as well as
# logged. Unset = logged only.
# REALM_SAFETY_EMAIL=safety@your-domain
# The owner's inbox for warnings (storage filling up, floods of wrong passwords). Falls back to
# REALM_SAFETY_EMAIL; unset = the log only.
# REALM_ALERT_EMAIL=you@example.com

# ── Uploads: Cloudflare R2 (any S3-compatible storage) ──────────────────────────
# Unset = files are kept in REALM_LOCAL_MEDIA_DIR on this machine.
# S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
#   (a bucket made in the EU jurisdiction uses https://ACCOUNT_ID.eu.r2.cloudflarestorage.com)
# S3_REGION=auto
# S3_BUCKET=realm-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# The web app's security policy must allow the same address:
# REALM_STORAGE_ORIGIN=https://ACCOUNT_ID.r2.cloudflarestorage.com
REALM_LOCAL_MEDIA_DIR=.data/media
# Uploads pause once this many GB are stored, so storage never costs money by surprise (R2 is free
# up to 10 GB). Warnings go to REALM_ALERT_EMAIL at 90%, 93% and 97%, and when it's full. 0 = off.
REALM_STORAGE_LIMIT_GB=10

# ── Voice, video and screen sharing: LiveKit ────────────────────────────────────
# LIVEKIT_URL=wss://PROJECT.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# Only for your own LiveKit server (LiveKit Cloud is allowed by default):
# NEXT_PUBLIC_LIVEKIT_HOST=livekit.example.com

# ── Push notifications: Firebase Cloud Messaging ────────────────────────────────
# Server: the service account's JSON, raw or base64.
# FIREBASE_SERVICE_ACCOUNT=
# Browser (the web app's Firebase config and Web Push key):
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ── Maps: Google Maps (preferred) or Mapbox ─────────────────────────────────────
# Google wins when its key is set. A browser key restricted to Realm's web addresses, with only
# Maps JavaScript, Places (New), Geocoding and Maps Static APIs allowed (docs/SERVICES.md).
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIza...
# Optional: a Map ID from Google Cloud's map styling, for Realm's own map look.
# NEXT_PUBLIC_GOOGLE_MAP_ID=
# Or Mapbox: a public token (pk.), restricted to Realm's web addresses.
# NEXT_PUBLIC_MAPBOX_TOKEN=pk....

# ── Realtime gateway ────────────────────────────────────────────────────────────
# Development: the API serves it at /gateway. Production (with Redis): its own process.
NEXT_PUBLIC_REALM_GATEWAY_URL=ws://localhost:4000/gateway
REALM_GATEWAY_PORT=4001
REALM_WORKER_ID=1

# ── Testing on your phone (development) ─────────────────────────────────────────
# Open the dev servers to your home Wi-Fi: then visit http://<this PC's address>:3000 on the phone.
# REALM_API_HOST=0.0.0.0
# REALM_DEV_LAN=1
