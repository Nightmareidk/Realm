{
  "name": "@realm/api",
  "version": "0.1.0",
  "private": true,
  "description": "Realm REST API (/v1).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "emergency": "tsx --env-file-if-exists=../../.env src/emergency.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/swagger": "9.9.0",
    "@realm/contracts": "workspace:*",
    "@realm/db": "workspace:*",
    "@realm/server-core": "workspace:*",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@realm/tsconfig": "workspace:*",
    "@types/node": "26.6.3",
    "pino-pretty": "13.1.3",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
